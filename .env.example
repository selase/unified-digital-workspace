APP_NAME=UnifiedDigitalWorkspace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://unified-digital-workspace.test
APP_SIDEBAR_SKIN=light
# Tenant routing base; independent of session cookie scope.
TENANT_BASE_DOMAIN=unified-digital-workspace.test

SECRETS_PROVIDER=local

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Landlord Database (Global Control Plane)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=unified_digital_workspace
DB_USERNAME=root
DB_PASSWORD=
# Cloud: set verify-full with the provider CA; keep canonical DB_HOST.
DB_SSLMODE=prefer
DB_SSLROOTCERT=
# Directory containing the server-compatible pg_dump binary.
PG_DUMP_BINARY_PATH=

# Note: Tenant databases are managed dynamically by the system.
# Dedicated tenants are provisioned as additional postgres databases
# on the same host as the landlord (tenant_<uuid_with_underscores>).
TENANT_DB_DRIVER=pgsql

BROADCAST_DRIVER=log
# Cloud replicas must share a durable store; database is supported after migrations.
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed every job/worker timeout (billing mail: 120 seconds).
QUEUE_RETRY_AFTER=180
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Leave SESSION_DOMAIN empty for host-only cookies on isolated Cloud previews.
# Use an owned parent domain only when sharing sessions across its subdomains.
SESSION_DOMAIN=unified-digital-workspace.test

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Required for scheduled S3 backups; no local fallback. Use a private backup bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

ALLOW_REGISTRATION=false
ENABLE_SOCIAL_LOGIN=false
SOFTWARE_PROVIDER=Purpledot
SOFTWARE_PROVIDER_URL=https://wearepurpledot.com
SUPERADMIN_EMAIL=hiselase@gmail.com

THEME_PRIMARY_COLOR="#168f7f"
THEME_PRIMARY_COLOR_DARK="#1d6057"

IGNITION_EDITOR="vscode"

# Directory containing pg_dump (leave empty to use PATH). Used by backup:run and tenant database removal.
PG_DUMP_BINARY_PATH=

# One success email after the daily S3 backup; failures are sent immediately.
# Cleanup and healthy-monitor success emails are disabled.
BACKUP_NOTIFICATION_EMAIL=

# Supplier VAT registration and commercial rates must be approved before enabling.
BILLING_COUNTRY_TAXES_ENABLED=false

# Platform invoice payments. Set production secrets through Forge, never commit them.
# Paystack webhook URL: https://<APP_URL-host>/webhooks/paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MERCHANT_EMAIL=
# Optional USD invoice checkout remains on Stripe.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
