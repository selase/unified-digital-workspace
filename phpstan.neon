includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    - phar://phpstan.phar/conf/bleedingEdge.neon
    - phpstan-baseline.neon

parameters:

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - public
        - routes


    level: 6

    databaseMigrationsPath:
        - database/migrations/landlord
        - database/migrations/tenant
        - app/Modules/CmsCore/Database/Migrations
        - app/Modules/DocumentManagement/Database/Migrations
        - app/Modules/Forums/Database/Migrations
        - app/Modules/HrmsCore/Database/Migrations
        - app/Modules/IncidentManagement/Database/Migrations
        - app/Modules/Memos/Database/Migrations
        - app/Modules/ProjectManagement/Database/Migrations
        - app/Modules/QualityMonitoring/Database/Migrations

    tmpDir: /tmp/phpstan