      "body": "<section>\n        <div class=\"container my-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto text-center\">\n                <h2 class=\"display-4\">Our Team</h2>\n                <p class=\"lead\">We are committed to saving lives and building resilience through targeted programs in drowning prevention, road safety, addiction recovery, and disaster preparedness.</p>\n                </div>\n            </div>\n        </div>\n        \n    </section>\n\n    <section>\n        <div class=\"container my-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-12 col-md-12 mx-auto\">\n                \n                <div class=\"row\">\n                    <div class=\"col-md-3 mb-4\">\n                        <div class=\"card\">\n                            <img src=\"__LPP_ASSET_ed9bd3ecda43aad27ec843cfa8cb67b1466e877d5507a04768a2f96096600fd2__\" class=\"card-img-top\" alt=\"Life Partners Platform team member\">\n                            <div class=\"card-body\">\n                                <h5 class=\"card-title\">Mr. Abrokwa </h5>\n                                <p class=\"card-text\">Country Representative</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-md-3 mb-4\">\n                        <div class=\"card\">\n                            <img src=\"__LPP_ASSET_a1ccfcffd41fa8470a34e4e592ab83c7fce3c764ffddcdcb8db351af0fe44ef1__\" class=\"card-img-top\" alt=\"Life Partners Platform team member\">\n                            <div class=\"card-body\">\n                                <h5 class=\"card-title\">Abdul-Rauf Zakaria</h5>\n                                <p class=\"card-text\">Director of Operations</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-md-3 mb-4\">\n                        <div class=\"card\">\n                            <img src=\"__LPP_ASSET_0cf617604881187671ac9f08a0ce44ae0917fc0e4c2996d8ce7b85a2018399ea__\" class=\"card-img-top\" alt=\"Life Partners Platform team member\">\n                            <div class=\"card-body\">\n                                <h5 class=\"card-title\">Reachel Naa Dedei Okine </h5>\n                                <p class=\"card-text\">Head of Operations</p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-md-3 mb-4\">\n                        <div class=\"card\">\n                            <img src=\"__LPP_ASSET_9f93a360f48c4b1ddaf691c337276b937ea766572f036ed68801038d44da71de__\" class=\"card-img-top\" alt=\"Life Partners Platform team member\">\n                            <div class=\"card-body\">\n                                <h5 class=\"card-title\">Bernice Padi</h5>\n                                <p class=\"card-text\">Financial Coordinator</p>\n                            </div>\n                        </div>\n                    </div>\n\n                </div>\n            </div>\n        </div>\n        \n    </section>"
