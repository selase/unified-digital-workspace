    {
      "slug": "areas-of-operation",
      "title": "Areas of Operation",
      "source_file": "views/areas-of-operation.php",
      "source_sha256": "3020dd52003c7baadb552e101ae5b8b81df9295824adb4653a99055c527a8ffe",
      "body": "<section>\n        <div class=\"container my-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto text-center\">\n                <h2 class=\"display-4\">Areas of Operation</h2>\n                <p class=\"lead\">We focus on drowning prevention, road safety, addiction recovery, and resilience building.</p>\n                </div>\n            </div>\n        </div>\n        \n    </section>\n\n    <section>\n        <div class=\"container my-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto\">\n                \n                <p>Our organization undertakes a range of operations, including:</p>\n                <ol>\n                    <li>Providing comprehensive training in swimming skills and first response to community volunteers.</li>\n                    <li>Educating communities and raising awareness about prevention methods for emergencies that arise locally.</li>\n                    <li>Supporting local initiatives through donations, mobilization, and action.</li>\n                    <li>Conducting research and data collection to develop, design, and test solutions for challenges related to drowning, road safety, and substance abuse.</li>\n                </ol>\n\n                <p>We create community rescue club opportunities to facilitate programs, events, and activities. This approach fosters a spirit of community involvement and integrates cultural and indigenous methods to address these challenges.</p>\n\n                \n\n                </div>\n            </div>\n        </div>\n        \n    </section>"
    }
  ],
