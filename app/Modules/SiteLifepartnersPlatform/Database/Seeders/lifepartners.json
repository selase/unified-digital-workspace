      "slug": "home",
      "title": "Home",
      "source_file": "views/index.php",
      "source_sha256": "76f9c9b29b595c7e884f57347fc7daa2798ab64cdd1e74dd6cd5df393d8825d7",
      "body": "<div class=\"page-header align-items-start min-vh-50 pt-5 pb-11 m-3 border-radius-lg lpp-has-background\"><img class=\"lpp-background\" src=\"__LPP_ASSET_9829ed01b1daf81aac3a5f538240ea634889d817da5f2c2d65f5979f9f43e014__\" alt=\"\" aria-hidden=\"true\">\n      <span class=\"mask bg-gradient-dark opacity-6\"></span>\n      <div class=\"container\">\n        <div class=\"row\">\n          <div class=\"col-lg-5 mt-lg-10 mt-md-11 mt-10\">\n            <h1 class=\"text-white mb-2 mt-5\">Saving Lives, Building Resilience</h1>\n            <p class=\"text-lead text-white\">Empowering Ghanaian communities to prevent drowning, reduce road accidents, and overcome addiction.</p>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <section>\n        <div class=\"container mt-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto text-center\">\n                <h2 class=\"display-4\">What We Do</h2>\n                <p class=\"lead\">We focus on drowning prevention, road safety, addiction recovery, and resilience building.</p>\n                </div>\n            </div>\n        </div>\n        <div class=\"container mt-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-4 col-md-6 mb-4\">\n                    <div class=\"card text-center\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Drowning Prevention</h5>\n                            <p class=\"card-text\">Teaching swim skills, installing lifeguard posts, and running awareness campaigns.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-lg-4 col-md-6 mb-4\">\n                    <div class=\"card text-center\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Road Safety</h5>\n                            <p class=\"card-text\">Advocating for safer roads, helmets & seat-belt use, community patrols.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-lg-4 col-md-6 mb-4\">\n                    <div class=\"card text-center\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Addiction Recovery</h5>\n                            <p class=\"card-text\">Counseling, support groups, vocational training for recovering addicts.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-lg-4 col-md-6 mb-4\">\n                    <div class=\"card text-center\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Resilience Building</h5>\n                            <p class=\"card-text\">First-aid training, disaster-preparedness workshops, youth empowerment.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    \n    <section>\n        <div class=\"container mt-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto text-center\">\n                <h2 class=\"display-4\">Our Mission</h2>\n                <p class=\"lead\">We are dedicated to saving lives and building resilience in Ghanaian communities through education, training, and support.</p>\n                </div>\n            </div>\n            \n            <div class=\"row\">\n                <div class=\"col-md-3\">\n                    <div class=\"card lpp-has-background\"><img class=\"lpp-background\" src=\"__LPP_ASSET_2234816704abc86202bee04c652da987d1e3f5cd1263b893fa64c7dd0b45efac__\" alt=\"\" aria-hidden=\"true\">\n                        \n                    </div>\n                </div>\n                <div class=\"col-md-3\">\n                    <div class=\"card lpp-has-background\"><img class=\"lpp-background\" src=\"__LPP_ASSET_bcfa883fb602e16583c67fce39ecc83d0f763fc72a26ef4aab30f943091dcbe8__\" alt=\"\" aria-hidden=\"true\">\n                        \n                    </div>\n                </div>\n                <div class=\"col-md-3\">\n                    <div class=\"card lpp-has-background\"><img class=\"lpp-background\" src=\"__LPP_ASSET_3d25da34d5ef085e60243fa39b13e2645a60c9c2291e4e94f1d16749cd3853c6__\" alt=\"\" aria-hidden=\"true\">\n                    </div>\n                </div>\n                <div class=\"col-md-3\">\n                    <div class=\"card lpp-has-background\"><img class=\"lpp-background\" src=\"__LPP_ASSET_8496743f445fc20a8c5549e8362a438d74cf45ae452e7721a5874f197a4ccc53__\" alt=\"\" aria-hidden=\"true\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"mt-5\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto text-center\">\n                    <h2 class=\"display-4\">Success Stories</h2>\n                    <p class=\"lead mt-3 mb-5\">“Life Partners’ swim-training saved my little brother’s life when he fell into the lagoon.”</p>\n                    <blockquote class=\"blockquote text-center\">\n                        <p class=\"mb-0\">— Aisha, mother of two</p>\n                    </blockquote>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    \n    <section class=\"mt-5\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto text-center\">\n                    <h2 class=\"display-4\">Get Involved</h2>\n                    <p class=\"lead mt-3 mb-5\">Join us in our mission to save lives and build resilience in Ghanaian communities.</p>\n                    <ul class=\"list-unstyled\">\n                        <li>Volunteer</li>\n                        <li>Partner with us</li>\n                    </ul>\n                </div>\n            </div>\n        </div>\n\n\n    \n\n    \n\n    </div>"
    },
    {
      "slug": "about",
      "title": "About us",
      "source_file": "views/about.php",
      "source_sha256": "cce749c29af81328528b2a63673d45fe12510fc0fdc5f255080b59c875c07ec1",
      "body": "<section>\n        <div class=\"container my-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto text-center\">\n                <h2 class=\"display-4\">Who we are</h2>\n                <p class=\"lead\">We focus on drowning prevention, road safety, addiction recovery, and resilience building.</p>\n                </div>\n            </div>\n        </div>\n        \n    </section>\n\n    <section>\n        <div class=\"container my-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto\">\n                \n                <p>\n                    The Life Partners Platform (LPP) is a registered non-governmental organization in Ghana with the goal of reducing drowning deaths and drowning-related losses as well as encouraging road safety. The organization in addition appreciates prudent measures taken to combat drug and substance abuse among the youth in Ghana.\n                </p>\n                <p>\n                    By promoting advocacy, the organization hopes to garner public and governmental attention as well as support for the implementation of innovative approaches to these issues.\n                </p>\n                <p>\n                    Additionally research and data management are also areas of interest for the organization, since decisions taken will be data driven to guide policy and legal enactments about drowning, traffic accidents, and substance abuse. Through sensitization, training, planning, and the implementation of practical interventions, we firmly believe that communities, institutions, and schools can be empowered to speculate, identify, and take the first steps toward managing or addressing these issues.\n                </p>\n                <p>\n                    We emphasize the value of cooperation and have strong partnerships with a range of stakeholders, including bilateral and multilateral organizations, state agencies, NGOs, CBOs, and faith-based organizations. Now, LPP is the only non-governmental organization in Ghana whose operations focus on community drowning prevention.\n                </p>\n                <p>\n                    We pledge our unwavering commitment towards the safety, health and overall well-being of every individual, collectively in Ghana.\n                </p>\n\n                </div>\n            </div>\n        </div>\n        \n    </section>\n\n    <section id=\"vision\" class=\"\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"col\">\n                    <h2 class=\"display-4\">Our Vision</h2>\n                </div>\n                <div class=\"col\">\n                    <p class=\"lead\">A world where everyone is empowered to live a life free from preventable harm.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <hr>\n\n    <section id=\"mission\" class=\"my-6\">\n        <div class=\"container\">\n            <div class=\"row\">\n                <div class=\"col\">\n                    <h2 class=\"display-4\">Our Mission</h2>\n                </div>\n                <div class=\"col\">\n                    <p class=\"lead\">To create a community that is informed, empowered and active in preventing harm and promoting well-being.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"core-values\" class=\"text-center my-8\">\n        <div class=\"container\">\n            <h2 class=\"display-4\">Core Values</h2>\n            <div class=\"row\">\n            <div class=\"container mt-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-3 col-md-6 mb-4\">\n                    <div class=\"card text-center\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Compassion</h5>\n                            <p class=\"card-text\">We meet every person with empathy and respect.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-lg-3 col-md-6 mb-4\">\n                    <div class=\"card text-center\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Integrity</h5>\n                            <p class=\"card-text\">We operate transparently and ethically</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-lg-3 col-md-6 mb-4\">\n                    <div class=\"card text-center\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Collaboration</h5>\n                            <p class=\"card-text\">We partner with communities, government and NGOs.</p>\n                        </div>\n                    </div>\n                </div>\n                <div class=\"col-lg-3 col-md-6 mb-4\">\n                    <div class=\"card text-center\">\n                        <div class=\"card-body\">\n                            <h5 class=\"card-title\">Innovation</h5>\n                            <p class=\"card-text\">We pursue creative solutions tailored to local needs.</p>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n            </div>\n        </div>\n    </section>"
    },
    {
      "slug": "what-we-do",
      "title": "What we do",
      "source_file": "views/what-we-do.php",
      "source_sha256": "3514a6114af19ff128a2487008b4c9aa697d2796ad24f21a6be2ff28673c7322",
      "body": "<section>\n        <div class=\"container my-5\">\n            <div class=\"row\">\n                <div class=\"col-lg-6 col-md-8 mx-auto text-center\">\n                    <h2 class=\"display-4\">What We Do</h2>\n                    <p class=\"lead\">We are committed to saving lives and building resilience through targeted programs in drowning prevention, road safety, addiction recovery, and disaster preparedness.</p>\n\n                    <p class=\"text-justify\">Life Partners Platform engages in community sensitization programs on water safety, road safety and the prevention of substances abuse in Ghanaians. The organization builds the capacity of communities through simulations exercises, training, sensitization, education and awareness creation.  This is done together with other community-based emergency response agencies helping to build their confidence in preparedness, respond and recovery during an emergency.</p>\n                    \n                    <p class=\"text-justify\">We also have accredited trainers who train in basic survival swimming skills for both children and adults in communities to international standards. Our technical experts  spends quality time with clients to ensure the acquisition of knowledge, attitudes and practices that enhance swimming survival.</p>\n                    <p class=\"text-justify\">Our community education, sensitization and awareness creation are packages that hinge on capacity building. Therefore, safety instructions and donation of safety gears are our way of identifying the nexus between preparedness and philanthropical actions.</p>\n                    </div>\n                \n\n            </div>\n        </div>\n    </section>\n\n    <section id=\"drowning-prevention\" class=\"my-6\">\n        <div class=\"container\">\n            <h2 class=\"display-4 text-center\">Drowning Prevention, Reduction & Resilience</h2>\n            <div class=\"row mt-4\">\n                <div class=\"col-md-6\">\n                    <h5>Training & Education</h5>\n                    <ul>\n                        <li>Free community swim-lessons for children & adults</li>\n                        <li>Certified “Water Safety Champion” workshops</li>\n                    </ul>\n                    <h5>Infrastructure Support</h5>\n                    <ul>\n                        <li>Installing safe-access points on lagoons & rivers</li>\n                        <li>Supplying lifebuoys, rescue-poles, signage</li>\n                    </ul>\n                </div>\n                <div class=\"col-md-6\">\n                    <h5>Awareness Campaigns</h5>\n                    <ul>\n                        <li>School tours, radio spots, billboards</li>\n                    </ul>\n                    <p><strong>Outcome Goal:</strong> 30% fewer drowning incidents in Greater Accra, Central and Volta regions.</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"road-safety\" class=\"my-6 bg-light py-5\">\n        <div class=\"container\">\n            <h2 class=\"display-4 text-center\">Road Safety Promotion</h2>\n            <div class=\"row mt-4\">\n                <div class=\"col-md-6\">\n                    <h5>Advocacy & Enforcement</h5>\n                    <ul>\n                        <li>Helmet & seat-belt campaigns</li>\n                        <li>Community-led road-watch patrols</li>\n                    </ul>\n                </div>\n                <div class=\"col-md-6\">\n                    <h5>Skills Training</h5>\n                    <ul>\n                        <li>Defensive driving courses for taxi/motor-taxi drivers</li>\n                        <li>Pedestrian safety workshops for school children</li>\n                    </ul>\n                    <p><strong>Outcome Goal:</strong> Reduce road fatalities by 20% in target municipalities</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"addiction-recovery\" class=\"my-6\">\n        <div class=\"container\">\n            <h2 class=\"display-4 text-center\">Drug Addiction Reduction & Rehabilitation</h2>\n            <div class=\"row mt-4\">\n                <div class=\"col-md-6\">\n                    <h5>Prevention</h5>\n                    <ul>\n                        <li>Community dialogues on narcotics risks</li>\n                        <li>Youth peer-mentoring programs</li>\n                    </ul>\n                </div>\n                <div class=\"col-md-6\">\n                    <h5>Rehabilitation Support</h5>\n                    <ul>\n                        <li>Counseling and group therapy sessions</li>\n                        <li>Job-skills training and reintegration assistance</li>\n                    </ul>\n                    <p><strong>Outcome Goal:</strong> 500 individuals complete rehab and gain sustainable livelihoods</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"resilience-building\" class=\"my-6 bg-light py-5\">\n        <div class=\"container\">\n            <h2 class=\"display-4 text-center\">Support Initiatives & Resilience Building</h2>\n            <div class=\"row mt-4\">\n                <div class=\"col-md-6\">\n                    <h5>Disaster Preparedness</h5>\n                    <ul>\n                        <li>First-aid certification courses</li>\n                        <li>Community emergency-response team formation</li>\n                    </ul>\n                </div>\n                <div class=\"col-md-6\">\n                    <h5>Empowerment Workshops</h5>\n                    <ul>\n                        <li>Leadership and life-skills training for youth and women</li>\n                    </ul>\n                    <p><strong>Outcome Goal:</strong> 100 community committees equipped to lead in crises</p>\n                </div>\n            </div>\n        </div>\n    </section>\n\n    <section id=\"why-we-do-what-we-do\" class=\"my-6\">\n        <div class=\"container\">\n            <h2 class=\"display-4 text-center\">Why We Do What We Do</h2>\n       \n\n            <div class=\"col-md-6 mx-auto\">\n            <p class=\"text-justify\">Due to the high national death toll from drowning, road accidents, and substance abuse, LPP is committed to saving and improving the quality of lives in Ghana. Unfortunately, there is a lack of public awareness among communities about these preventable issues. Owing to the remote nature of most communities where these incidents occur, little or no attention is given to these priority areas. Life Partners Platform offers a national platform through several lifesaving programs, training, and advocacy to the at-risk population. Life Partners Platform is the game-changer for marginalized communities where the risk is high and government services are limited.</p>\n            </div>\n\n        </div>\n    </section>"
    },
